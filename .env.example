# demo: 내 PC의 파일과 정해진 질문을 사용하며 외부 AI에 요청하지 않습니다.
# ncloud: 아래 NCP 설정이 모두 필요하며 실패해도 demo로 몰래 전환하지 않습니다.
APP_MODE=demo
APP_DATA_DIR=.data
APP_PUBLIC_ORIGIN=http://127.0.0.1:3000
APP_COOKIE_SECURE=false

# 이 파일을 .env.local로 복사한 뒤 서버에서만 실제 값을 입력합니다.
# 값에 #나 공백이 있으면 값 전체를 큰따옴표로 감쌉니다. 복사할 때 앞뒤 공백은 덧붙이지 않습니다.
# Next.js 앱에서 문자 $ 자체를 쓰려면 \$로 적습니다. Node --env-file과는 해석이 다를 수 있습니다.
# 문법과 직접 점검의 차이는 docs/NCLOUD_SETUP.md의 설정 파일 설명을 확인합니다.
# 비밀값에 NEXT_PUBLIC_을 붙이면 브라우저에 노출될 수 있으므로 사용하지 않습니다.
# 저장소 접근용 키 2개와 비공개 버킷 이름입니다.
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
NCP_BUCKET=
# PostgreSQL의 내부 접속 주소·포트·DB·사용자·비밀번호입니다.
PGHOST=
PGPORT=5432
PGDATABASE=memorydb
PGUSER=memoryapp
PGPASSWORD=
# Object Storage 키와 별도로 발급하는 CLOVA Studio API 키입니다.
CLOVA_STUDIO_API_KEY=
